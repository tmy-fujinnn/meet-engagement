{
  "manifest_version": 3,
  "name": "Class Engagement (Google Meet)",
  "version": "0.1.0",
  "description": "Opt-in engagement analytics for your class on Google Meet. Shares activity counts with your professor; never message text, audio or video.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": ["https://meet.google.com/*", "https://*.trycloudflare.com/*", "http://localhost:3000/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Class Engagement" }
}
